{
  "name": "dsh-startup-screen",
  "version": "1.4.0-mecha.3",
  "description": "DSH 启动动画 · 解限机风格改编：官方动态图标、透明中文 Logo、游戏原声与系统播报。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "startup",
    "splash",
    "boot-animation",
    "mecha-break",
    "mecha",
    "sci-fi"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "DESKTOP.md",
    "AUDIO-FIELDS.md",
    "MECHA-EDITION.md",
    "LICENSE",
    "docs/MECHA-ASSET-SOURCES.json"
  ],
  "scripts": {
    "test": "node test/smoke-host.mjs && node test/smoke-splash.mjs && node test/smoke-client.mjs && node test/smoke-desktop-boot.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/16shilu/dsh-startup-screen-mecha.git"
  },
  "bugs": {
    "url": "https://github.com/16shilu/dsh-startup-screen-mecha/issues"
  },
  "homepage": "https://github.com/16shilu/dsh-startup-screen-mecha#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "沈宏宏",
  "contributors": [
    {
      "name": "dy拾鹭",
      "url": "https://github.com/16shilu"
    }
  ]
}
